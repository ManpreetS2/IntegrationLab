# Local development environment for IntegrationLab backend.
# Do NOT commit a real .env file.

APP_ENV=development

DATABASE_URL=postgresql+psycopg://integrationlab:integrationlab@localhost:5432/integrationlab
TEST_DATABASE_URL=postgresql+psycopg://integrationlab:integrationlab@localhost:5432/integrationlab_test

# AWS alternative to DATABASE_URL (ECS injects these). Never commit real values.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=integrationlab
# INTEGRATIONLAB_DB_SECRET=
# INTEGRATIONLAB_APP_SECRETS=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/github/callback
FRONTEND_URL=http://localhost:5173

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Stripe webhook signing secret (whsec_...). Never commit a real value.
STRIPE_WEBHOOK_SECRET=

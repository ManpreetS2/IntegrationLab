*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / installers
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment and secrets
.env
.env.*
!.env.example
!frontend/.env.production

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

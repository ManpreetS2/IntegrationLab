# Local development environment for IntegrationLab.
# Copy to backend/.env. Do NOT commit a real .env file.

APP_ENV=development
# Optional deploy identifier (Git SHA in AWS).
# APP_VERSION=

DATABASE_URL=postgresql+psycopg://integrationlab:integrationlab@localhost:5432/integrationlab
TEST_DATABASE_URL=postgresql+psycopg://integrationlab:integrationlab@localhost:5432/integrationlab_test

# AWS deployment alternative to DATABASE_URL (do not set both unless you
# intentionally want DATABASE_URL to win). Values are injected by ECS from
# Secrets Manager — never commit real passwords.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=integrationlab
# DB_USER=
# INTEGRATIONLAB_DB_SECRET={"username":"...","password":"..."}
# INTEGRATIONLAB_APP_SECRETS={"GITHUB_CLIENT_ID":"...","GITHUB_CLIENT_SECRET":"...","TOKEN_ENCRYPTION_KEY":"...","STRIPE_WEBHOOK_SECRET":"..."}

# GitHub OAuth App (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/github/callback
FRONTEND_URL=http://localhost:5173

# Fernet key for encrypting provider access tokens at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Stripe webhook signing secret (whsec_...). For local testing, `stripe listen`
# prints one. Never commit a real value.
STRIPE_WEBHOOK_SECRET=

# Frontend (Vite): unset locally → http://localhost:8000.
# Production build sets VITE_API_URL= (empty) for same-origin CloudFront.
# VITE_API_URL=

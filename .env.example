# Local development environment for IntegrationLab.
# Copy to backend/.env. Do NOT commit a real .env file.

DATABASE_URL=postgresql+psycopg://integrationlab:integrationlab@localhost:5432/integrationlab
TEST_DATABASE_URL=postgresql+psycopg://integrationlab:integrationlab@localhost:5432/integrationlab_test

# GitHub OAuth App (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/github/callback
FRONTEND_URL=http://localhost:5173

# Fernet key for encrypting provider access tokens at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Stripe webhook signing secret (whsec_...). For local testing, `stripe listen`
# prints one. Never commit a real value.
STRIPE_WEBHOOK_SECRET=
